<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.MySplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/transparent</item>
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Theme.GBTranslate</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.GBTranslate" parent="android:Theme.Material.NoActionBar" />

    <style name="Theme.GBTranslate.SplashScreen" parent="Theme.GBTranslate">
        <item name="android:windowBackground">@drawable/ic_splash</item>
    </style>
</resources>